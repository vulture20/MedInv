# MedInv – Docker-Umgebungsvariablen / Docker environment variables
#
# DE: Vorlage für alle Umgebungsvariablen, die docker-compose.yml für den
#     Anwendungscontainer (und, falls verwendet, die mariadb/postgres-Dienste)
#     einliest. Diese Datei nach `.env` kopieren und die Werte anpassen –
#     docker compose lädt `docker/.env` automatisch, wenn es aus diesem
#     Verzeichnis heraus aufgerufen wird (`cd docker && docker compose up`).
#     `.env` enthält danach echte Zugangsdaten und sollte NICHT eingecheckt
#     werden (siehe docker/.gitignore).
#
# EN: Template for every environment variable docker-compose.yml reads for
#     the application container (and, if used, the mariadb/postgres
#     services). Copy this file to `.env` and fill in the values – docker
#     compose loads `docker/.env` automatically when run from this
#     directory (`cd docker && docker compose up`). The resulting `.env`
#     holds real credentials and should NOT be committed (see
#     docker/.gitignore).
#
# DE: Alternative statt einer .env-Datei: dieselben Variablen direkt als
#     Shell-Umgebungsvariablen vor `docker compose up` setzen (siehe README).
# EN: Alternative to a .env file: set the same variables directly as shell
#     environment variables before `docker compose up` (see README).

# --- Erforderlich / Required (briefing 16.) -------------------------------
# DE: Zugangsdaten des initialen Administrator-Kontos, das beim ersten
#     Start automatisch angelegt wird. Ohne diese beiden Variablen startet
#     der Container nicht (docker-compose.yml erzwingt sie).
# EN: Credentials for the initial administrator account, created
#     automatically on first start. The container refuses to start without
#     both of these (enforced by docker-compose.yml).
MEDINV_ADMINUSER=admin@example.com
MEDINV_ADMINPASS=

# --- Netzwerk / Deployment-URL / Network / deployment URL -----------------
# DE: Port, auf dem nginx im Container lauscht – bedient sowohl die
#     Oberfläche als auch, unter /api und /sanctum, die API. Es gibt
#     bewusst keinen separaten API-Port (siehe CLAUDE.md).
# EN: Port nginx listens on inside the container – serves both the UI and,
#     under /api and /sanctum, the API. There is deliberately no separate
#     API-only port (see CLAUDE.md).
MEDINV_PortWeb=8080

# DE: Öffentliche URL, unter der diese Instanz tatsächlich erreichbar ist
#     (z. B. hinter einem Reverse Proxy auf einer echten Domain). Wird als
#     Laravel-APP_URL verwendet und – sofern SANCTUM_STATEFUL_DOMAINS nicht
#     explizit gesetzt ist – automatisch zusätzlich zu localhost/127.0.0.1
#     als gültiger Login-Ursprung akzeptiert. Bei reinem
#     localhost/127.0.0.1-Zugriff kann dies leer bleiben.
# EN: The public URL this instance is actually reachable at (e.g. behind a
#     reverse proxy on a real domain). Used as Laravel's APP_URL and,
#     unless SANCTUM_STATEFUL_DOMAINS is set explicitly, automatically
#     accepted as a valid login origin in addition to localhost/127.0.0.1.
#     Leave empty for plain localhost/127.0.0.1 access.
MEDINV_URL=

# DE: Überschreibt Laravels APP_URL direkt, falls die Ableitung aus
#     MEDINV_URL/MEDINV_PortWeb nicht passt. In der Regel nicht nötig.
# EN: Overrides Laravel's APP_URL directly, if the value derived from
#     MEDINV_URL/MEDINV_PortWeb doesn't fit. Usually not needed.
APP_URL=

# DE: Liste gültiger Login-Ursprünge (Host[:Port], kommagetrennt) für
#     Sanctums Cookie-Authentifizierung. Leer lassen, damit entrypoint.sh sie
#     automatisch aus localhost/127.0.0.1 + MEDINV_URL berechnet (siehe
#     CLAUDE.md, Abschnitt „Auth: Sanctum SPA cookies"). Ein falscher Wert
#     hier lässt den Login mit korrekten Zugangsdaten scheinbar grundlos
#     fehlschlagen. Nur explizit setzen, wenn diese Heuristik den eigenen
#     Fall nicht abdeckt.
# EN: List of valid login origins (host[:port], comma-separated) for
#     Sanctum's cookie authentication. Leave empty so entrypoint.sh computes
#     it automatically from localhost/127.0.0.1 + MEDINV_URL (see
#     CLAUDE.md's "Auth: Sanctum SPA cookies" section). A wrong value here
#     makes login fail for seemingly no reason even with correct
#     credentials. Only set this explicitly if that heuristic doesn't cover
#     your setup.
SANCTUM_STATEFUL_DOMAINS=

# DE: Laravel-Verschlüsselungsschlüssel für Sitzungen/Cookies. Muss NICHT
#     manuell gesetzt werden – wird beim ersten Start automatisch erzeugt
#     und im `storage`-Volume gespeichert, sodass er einen
#     Container-Neustart übersteht. Nur setzen, wenn ein bestehender
#     Schlüssel wiederverwendet werden soll (z. B. Restore auf einem neuen
#     Host).
# EN: Laravel's encryption key for sessions/cookies. Does NOT need to be set
#     manually – generated automatically on first start and persisted in the
#     `storage` volume so it survives container recreation. Only set this if
#     you need to reuse an existing key (e.g. restoring onto a new host).
APP_KEY=

# --- Datenbank / Database (briefing 10., 16.) ------------------------------
# DE: Alle Datenbank-Variablen sind bewusst mit MEDINV_ statt des sonst
#     üblichen DB_-Präfixes benannt, damit jede von der Anwendung gelesene
#     Umgebungsvariable einheitlich mit MEDINV_ beginnt (siehe CLAUDE.md).
# EN: All database variables are deliberately named MEDINV_-prefixed
#     instead of the otherwise usual DB_ prefix, so every environment
#     variable this application reads consistently starts with MEDINV_
#     (see CLAUDE.md).

# DE: Datenbank-Backend: sqlite (Standard, keine weiteren Dienste nötig) |
#     mariadb | pgsql. Bei mariadb/pgsql zusätzlich
#     `docker compose --profile mariadb up` bzw. `--profile postgres up`
#     verwenden, damit der passende Datenbank-Dienst mitgestartet wird.
# EN: Database backend: sqlite (default, no extra services needed) |
#     mariadb | pgsql. For mariadb/pgsql also use
#     `docker compose --profile mariadb up` or `--profile postgres up` so
#     the matching database service is started alongside the app.
MEDINV_DB_CONNECTION=sqlite

# DE: Hostname des Datenbankservers (nur relevant für mariadb/pgsql; bei
#     sqlite ignoriert). Beim mitgelieferten mariadb-Profil ist das der
#     Servicename „mariadb".
# EN: Database server hostname (only relevant for mariadb/pgsql; ignored
#     for sqlite). With the bundled mariadb profile this is the service
#     name "mariadb".
MEDINV_DB_HOST=mariadb

# DE: Port des Datenbankservers (nur relevant für mariadb/pgsql).
# EN: Database server port (only relevant for mariadb/pgsql).
MEDINV_DB_PORT=3306

# DE: Name der Datenbank (nur relevant für mariadb/pgsql; bei sqlite wird
#     stattdessen eine Datei im `sqlite-data`-Volume verwendet).
# EN: Database name (only relevant for mariadb/pgsql; sqlite uses a file in
#     the `sqlite-data` volume instead).
MEDINV_DB_DATABASE=medinv

# DE: Datenbank-Benutzername (nur relevant für mariadb/pgsql).
# EN: Database username (only relevant for mariadb/pgsql).
MEDINV_DB_USERNAME=medinv

# DE: Datenbank-Passwort (nur relevant für mariadb/pgsql). ACHTUNG: Der
#     Standardwert "medinv" ist nur für schnelles lokales Ausprobieren
#     gedacht und trivial zu erraten. docker-compose.yml exponiert die
#     mariadb/postgres-Dienste zwar standardmäßig nicht am Host, aber bei
#     jedem produktiven Einsatz (insbesondere sobald deren Port veröffentlicht
#     wird oder weitere Container dasselbe Docker-Netzwerk teilen) hier
#     unbedingt ein eigenes, starkes Passwort setzen — anders als
#     MEDINV_ADMINPASS wird das hier nicht erzwungen.
# EN: Database password (only relevant for mariadb/pgsql). WARNING: the
#     default value "medinv" is meant for quick local trial-runs only and is
#     trivially guessable. docker-compose.yml does not expose the
#     mariadb/postgres services to the host by default, but for any
#     production use (especially once that port is published, or another
#     container shares the same Docker network) always set your own strong
#     password here — unlike MEDINV_ADMINPASS, this one is not enforced.
MEDINV_DB_PASSWORD=medinv

# DE: Tabellenpräfix, das alle von MedInv angelegten Tabellen erhalten, um
#     Kollisionen auf einem gemeinsam genutzten Datenbankserver zu
#     vermeiden (briefing 5.).
# EN: Table prefix applied to every table MedInv creates, to avoid
#     collisions on a shared database server (briefing 5.).
MEDINV_DB_PREFIX=MEDINV_

# --- Weitere MedInv-Variablen / Further MedInv variables (briefing 16.) ---
# DE: Initialer Loglevel: DEBUG | INFO | WARNING | ERROR – später auch im
#     Administrationsbereich änderbar, ohne Neustart.
# EN: Initial loglevel: DEBUG | INFO | WARNING | ERROR – also changeable
#     later in the admin area, without a restart.
MEDINV_LOGLEVEL=INFO

# DE: IP-Bereich, der vom Brute-Force-Schutz beim Login ausgenommen ist
#     (briefing 12.4).
# EN: IP range exempt from the brute-force login throttle (briefing 12.4).
MEDINV_TRUSTEDIP=

# DE: Name eines Backups, das beim Containerstart automatisch
#     wiederhergestellt werden soll (briefing 9.3). Derzeit nur eine
#     Warnung, falls gesetzt – die automatische Wiederherstellung beim
#     Start ist noch nicht implementiert (siehe CLAUDE.md,
#     „Known-incomplete areas").
# EN: Name of a backup to restore automatically on container start
#     (briefing 9.3). Currently only produces a warning if set – automatic
#     restore-on-boot isn't implemented yet (see CLAUDE.md's
#     "Known-incomplete areas").
MEDINV_RESTOREBACKUP=

# DE: Auf true setzen, um bei der Ersteinrichtung eine Beispiel-Bibliothek
#     mit Testdaten anzulegen (briefing 5.).
# EN: Set to true to seed an example library with test data on first setup
#     (briefing 5.).
MEDINV_SEED_SAMPLE_LIBRARY=false
