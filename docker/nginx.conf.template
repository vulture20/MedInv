worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    # GitHub issue #168: raised from 20m alongside docker/uploads.ini's
    # matching upload_max_filesize/post_max_size bump — a real backup .zip
    # (GitHub issue #167) already reaches ~20MB on a real deployment, right
    # at the old ceiling, and nginx's own 413 here is what a user actually
    # saw before PHP's own (even smaller) limit ever came into play.
    client_max_body_size 512m;

    # Web port (MEDINV_PortWeb, briefing 16.-style env var): the only port
    # nginx listens on. Serves the built React SPA and, on the same port,
    # proxies /api + /sanctum straight to php-fpm — this is what the browser
    # talks to, kept same-origin so Sanctum's SPA cookie auth and CORS need
    # no cross-port configuration (see frontend/src/api/client.ts,
    # VITE_API_BASE_URL=""). There is deliberately no separate API-only
    # port: every API consumer, browser or otherwise, uses this port's
    # /api prefix so the boundary between "web" and "API" stays a single,
    # consistently-enforced path prefix rather than two parallel surfaces.
    server {
        listen ${MEDINV_PortWeb};
        server_name _;

        location ^~ /api/ {
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        }

        location ^~ /sanctum/ {
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        }

        # Laravel's built-in health-check route (bootstrap/app.php's
        # `health: '/up'`) — proxied here so the Docker HEALTHCHECK
        # (Dockerfile) actually reaches php-fpm/Laravel instead of falling
        # through to the SPA's index.html below, which would report
        # "healthy" even if php-fpm had crashed entirely. Exact match, not
        # a prefix, since this is the one specific path Laravel registers.
        location = /up {
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        }

        # Everything else that looks like a PHP/API entrypoint must NOT
        # fall through to the SPA's index.html — only /api, /sanctum and the
        # single /up health-check path above are proxied to php-fpm; nothing
        # else on this port reaches Laravel at all, keeping the API surface
        # strictly limited to those.
        location / {
            root /var/www/spa;
            try_files $uri $uri/ /index.html;
        }
    }
}
