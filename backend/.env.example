APP_NAME=MedInv
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' (14-day retention, LOG_DAILY_DAYS below), not 'single' — several
# legitimate audit-trail log lines (login, password reset, user account
# changes, ...) carry a plaintext email/IP, and 'single' never rotates or
# expires storage/logs/laravel.log at all (GitHub issue #85). This is also
# config/logging.php's own PHP-level default now, which is what actually
# governs the shipped Docker image (no .env file ships in it at all) —
# kept here too so a local `cp .env.example .env` dev setup documents and
# gets the same behavior explicitly, not just by falling through to it.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (briefing 10.: abstraction layer, backend chosen freely at
# setup). All database env vars are MEDINV_DB_*-prefixed, not Laravel's
# stock DB_* names, so every MedInv-specific setting consistently starts
# with MEDINV_ (see config/database.php). ---
# One of: sqlite | mysql | mariadb | pgsql
MEDINV_DB_CONNECTION=sqlite
# MEDINV_DB_HOST=127.0.0.1
# MEDINV_DB_PORT=3306
# MEDINV_DB_DATABASE=medinv
# MEDINV_DB_USERNAME=medinv
# MEDINV_DB_PASSWORD=
# All MedInv-created tables are prefixed to avoid collisions on a shared DB server (briefing 5.).
MEDINV_DB_PREFIX=MEDINV_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Frontend / Sanctum SPA auth (see config/cors.php, config/sanctum.php) ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# --- Mail (fallback only — the mail server actually used for password reset
# is configured by an admin at runtime via /api/admin/settings/mail, briefing
# 12.2, and applied on top of this in App\Providers\AppServiceProvider) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- MedInv-specific environment variables (briefing chapter 16.) ---
# Initial admin account, created on first `artisan db:seed` (database/seeders/DatabaseSeeder.php).
MEDINV_ADMINUSER=admin@medinv.local
MEDINV_ADMINPASS=
# Initial loglevel: DEBUG | INFO | WARNING | ERROR — overridable later in the admin UI.
MEDINV_LOGLEVEL=WARNING
# IP(s) exempt from the brute-force login throttle (briefing 12.4): a comma-separated
# list of bare IPv4/IPv6 addresses and/or CIDR blocks, e.g. "10.0.0.5,192.168.1.0/24,::1".
MEDINV_TRUSTEDIP=
# Name of a backup to restore automatically on container start (briefing 9.3).
MEDINV_RESTOREBACKUP=
# Set to true to seed an example library with test data on first setup (briefing 5.).
MEDINV_SEED_SAMPLE_LIBRARY=false
# The public URL this instance is reachable at (Docker deployment only —
# e.g. behind a reverse proxy on a real domain). Used as APP_URL and, unless
# SANCTUM_STATEFUL_DOMAINS is set explicitly, folded into it automatically
# alongside localhost/127.0.0.1 (docker/entrypoint.sh). Leave unset for
# plain localhost/127.0.0.1 access.
MEDINV_URL=
# Port nginx listens on in the Docker deployment (docker/nginx.conf.template,
# docker/entrypoint.sh) — serves both the SPA and, under /api + /sanctum,
# the API; there is no separate API-only port. Not used by
# `php artisan serve` directly — pass `--port=` on the command line for
# local dev instead.
MEDINV_PortWeb=8080
